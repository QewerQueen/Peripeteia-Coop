<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>PeripeteiaCoop</AssemblyName>
    <RootNamespace>PeripeteiaCoop</RootNamespace>
    <Version>0.7.32</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 6 core assemblies (installed in the game folder). -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(PeripeteiaDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(PeripeteiaDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(PeripeteiaDir)\BepInEx\core\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(PeripeteiaDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(PeripeteiaDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Game-specific interop assemblies generated by BepInEx on first launch.
      They are not committed to the repository.
    -->
    <InteropAssembly Include="$(PeripeteiaDir)\BepInEx\interop\*.dll" />
    <Reference Include="@(InteropAssembly)">
      <HintPath>%(FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(PeripeteiaDir)' == ''">
    <Error Text="PeripeteiaDir is not set. Run scripts/setup.ps1 -GameDir &quot;...\Peripeteia&quot; or set the PERIPETEIA_DIR environment variable." />
  </Target>

  <Target Name="ValidateInterop" BeforeTargets="ResolveAssemblyReferences" Condition="'$(PeripeteiaDir)' != '' and !Exists('$(PeripeteiaDir)\BepInEx\interop\Assembly-CSharp.dll')">
    <Error Text="Interop assemblies are missing. Launch the game once with BepInEx 6 installed, then close it." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(PeripeteiaDir)' != ''">
    <MakeDir Directories="$(PeripeteiaDir)\BepInEx\plugins\PeripeteiaCoop" />
    <ItemGroup>
      <_PluginFile Include="$(TargetPath)" />
      <_PluginFile Include="$(TargetDir)LiteNetLib.dll" Condition="Exists('$(TargetDir)LiteNetLib.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFile)" DestinationFolder="$(PeripeteiaDir)\BepInEx\plugins\PeripeteiaCoop" SkipUnchangedFiles="true" />
  </Target>

</Project>
